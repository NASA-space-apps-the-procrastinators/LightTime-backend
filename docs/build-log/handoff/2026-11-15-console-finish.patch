--- /dev/null
+++ b/src/lib/alerts.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { beeps, canAcknowledge } from "@/lib/alerts";
+import type { Alert } from "@/lib/mission-store";
+
+const alert = (over: object) =>
+  ({ stage: "sent", acknowledgedAt: null, live: { state: "SOS" }, ...over }) as unknown as Alert;
+
+describe("the beep and the Acknowledge button", () => {
+  it("a live SOS beeps until someone acknowledges it, and can be acknowledged though it is already sent", () => {
+    expect(beeps(alert({}))).toBe(true);
+    expect(canAcknowledge(alert({}))).toBe(true);
+    const acked = alert({ acknowledgedAt: "2026-11-14T06:31:50Z" });
+    expect(beeps(acked)).toBe(false);
+    expect(canAcknowledge(acked)).toBe(false);
+  });
+
+  it("a resolved alert never beeps", () => {
+    expect(beeps(alert({ stage: "resolved" }))).toBe(false);
+    expect(canAcknowledge(alert({ stage: "resolved" }))).toBe(false);
+  });
+
+  it("a raised alert beeps and keeps its own button", () => {
+    const raised = alert({ stage: "raised", live: { state: "ALERT" } });
+    expect(beeps(raised)).toBe(true);
+    expect(canAcknowledge(raised)).toBe(false);
+  });
+
+  it("the built-in demo has no second button", () => {
+    expect(canAcknowledge(alert({ live: undefined }))).toBe(false);
+  });
+});
diff --git a/src/lib/alerts.ts b/src/lib/alerts.ts
new file mode 100644
index 0000000..389b998
--- /dev/null
+++ b/src/lib/alerts.ts
@@ -0,0 +1,17 @@
+import type { Alert } from "@/lib/mission-store";
+
+/** True while an alert should beep: raised and waiting, or a live SOS nobody has acknowledged. Never once resolved. */
+export function beeps(a: Alert): boolean {
+  if (a.stage === "resolved") return false;
+  return a.stage === "raised" || (a.live?.state === "SOS" && !a.acknowledgedAt);
+}
+
+/** True when a live alert past the "raised" stage can still be acknowledged. An SOS sends its own report, so it starts at "sent". */
+export function canAcknowledge(a: Alert): boolean {
+  return (
+    a.live != null &&
+    !a.acknowledgedAt &&
+    a.stage !== "raised" &&
+    a.stage !== "resolved"
+  );
+}
