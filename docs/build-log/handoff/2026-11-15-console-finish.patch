@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vitest";
+import { timeLeft } from "@/lib/format";
+
+describe("the time-left tile", () => {
+  const look = { eta_s: 70, red_line_at: "2026-11-14T06:31:41.701179Z" };
+
+  it("counts down on the ship's clock", () => {
+    expect(timeLeft(look, "2026-11-14T06:31:01.200000Z", "caution")).toEqual({ text: "40 s", urgent: false });
+  });
+
+  it("says when the time is up and when the line is crossed", () => {
+    expect(timeLeft(look, "2026-11-14T06:31:45Z", "caution")).toEqual({ text: "Due now", urgent: true });
+    expect(timeLeft(look, "2026-11-14T06:31:01Z", "emergency")).toEqual({ text: "Red line crossed", urgent: true });
+  });
+
+  it("shows the frozen figure when an older ship sends no deadline", () => {
+    expect(timeLeft({ eta_s: 70 }, undefined, "caution")).toEqual({ text: "1 min 10 s", urgent: false });
+  });
+});
