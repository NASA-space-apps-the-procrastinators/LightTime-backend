+
+/** The time-left tile: counts down to the red line on the ship's clock, and says when it is crossed. */
+export function timeLeft(
+  look: { eta_s: number; red_line_at?: string },
+  now: string | undefined,
+  level: string,
+): { text: string; urgent: boolean } {
+  if (level === "emergency") return { text: "Red line crossed", urgent: true };
+  if (!look.red_line_at || !now)
+    return { text: span(look.eta_s), urgent: false };
+  const left = Math.round((at(look.red_line_at) - at(now)) / 1000);
+  return left <= 0
+    ? { text: "Due now", urgent: true }
+    : { text: span(left), urgent: false };
+}
